<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SGP - Lista de Usuários</title>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600;700&display=swap');

        :root {
            --bg-body: #262626;
            --bg-sidebar: #1f1f1f;
            --bg-card: #303030;
            --primary: #686868;
            --accent: #004ba8;
            --danger: #962020;
            --text-main: #ffffff;
            --text-muted: #a1a0a0;
            --border-radius: 4px;
            --font: "Nunito", sans-serif;
            --sidebar-width: 60px;
        }

        /* --- Estilos Anteriores --- */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background-color: var(--bg-body); color: var(--text-main); font-family: var(--font); display: flex; height: 100vh; overflow: hidden; }
        .lg-sidebar { width: var(--sidebar-width); background-color: var(--bg-sidebar); display: flex; flex-direction: column; align-items: center; padding: 20px 0; flex-shrink: 0; }
        .lg-nav-item { color: var(--text-muted); padding: 12px; margin-bottom: 8px; border-radius: var(--border-radius); transition: all 0.2s ease; display: flex; align-items: center; }
        .lg-nav-item:hover, .lg-nav-item.active { background-color: rgba(255, 255, 255, 0.05); color: var(--text-main); }
        .lg-nav-item svg { width: 20px; height: 20px; }
        .lg-main-container { flex-grow: 1; padding: 40px; overflow-y: auto; display: flex; flex-direction: column; gap: 24px; }
        .lg-breadcrumb { display: flex; gap: 8px; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); align-items: center; }
        .lg-breadcrumb span::after { content: '/'; margin-left: 8px; }
        .lg-breadcrumb b { color: var(--text-main); }
        .lg-header-flex { display: flex; justify-content: space-between; align-items: flex-end; }
        .lg-display-1 { font-size: 28px; font-weight: 700; }
        .lg-table-container { background-color: var(--bg-sidebar); border-radius: var(--border-radius); overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.05); }
        .lg-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 13px; }
        .lg-table thead { background-color: rgba(0, 0, 0, 0.2); }
        .lg-table th { color: var(--primary); text-transform: uppercase; font-size: 10px; font-weight: 700; padding: 16px; letter-spacing: 0.5px; }
        .lg-table td { padding: 14px 16px; border-bottom: 1px solid rgba(255, 255, 255, 0.03); color: var(--text-muted); }
        .lg-table tr:hover td { background-color: rgba(255, 255, 255, 0.02); color: var(--text-main); }
        .lg-actions { display: flex; gap: 8px; }
        .lg-btn-icon { background: var(--bg-card); border: 1px solid var(--primary); color: var(--text-muted); padding: 6px; border-radius: var(--border-radius); cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; text-decoration: none; }
        .lg-btn-icon:hover { border-color: var(--text-main); color: var(--text-main); box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.1); }
        .lg-btn-icon.danger:hover { background-color: var(--danger); border-color: var(--danger); }
        .lg-btn-add { text-decoration: none; background: var(--accent); color: white; padding: 8px 16px; border-radius: var(--border-radius); font-size: 11px; font-weight: 700; text-transform: uppercase; display: flex; align-items: center; gap: 8px; border: none; cursor: pointer; }

        /* --- Modal Design --- */
        .lg-modal-overlay {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(4px);
            display: none; /* Escondido por padrão */
            align-items: center;
            justify-content: center;
            z-index: 1000;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .lg-modal-overlay.active {
            display: flex;
            opacity: 1;
        }

        .lg-modal {
            background: var(--bg-sidebar);
            width: 100%;
            max-width: 400px;
            padding: 32px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            text-align: center;
            transform: translateY(20px);
            transition: transform 0.3s ease;
        }

        .lg-modal-overlay.active .lg-modal {
            transform: translateY(0);
        }

        .lg-modal-icon {
            background: rgba(150, 32, 32, 0.1);
            color: var(--danger);
            width: 60px; height: 60px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 20px;
        }

        .lg-modal-title { font-size: 18px; font-weight: 700; margin-bottom: 8px; }
        .lg-modal-text { color: var(--text-muted); font-size: 14px; margin-bottom: 24px; line-height: 1.5; }

        .lg-modal-actions {
            display: flex;
            gap: 12px;
            justify-content: center;
        }

        .lg-btn-modal {
            padding: 10px 20px;
            border-radius: var(--border-radius);
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            cursor: pointer;
            border: none;
            transition: 0.2s;
        }

        .lg-btn-cancel { background: var(--bg-card); color: var(--text-main); border: 1px solid var(--primary); }
        .lg-btn-confirm { background: var(--danger); color: white; }
        .lg-btn-modal:hover { filter: brightness(1.2); }

    </style>
</head>

<body>
    <div class="lg-modal-overlay" id="modalApagar">
        <div class="lg-modal">
            <div class="lg-modal-icon">
                <i data-lucide="alert-triangle" style="width: 32px; height: 32px;"></i>
            </div>
            <h2 class="lg-modal-title">Excluir Usuário?</h2>
            <p class="lg-modal-text">Esta ação não pode ser desfeita. O usuário será removido permanentemente do sistema.</p>
            
            <div class="lg-modal-actions">
                <button class="lg-btn-modal lg-btn-cancel" onclick="fecharModal()">Cancelar</button>
                <button class="lg-btn-modal lg-btn-confirm" id="confirmarDelete">Excluir Agora</button>
            </div>
        </div>
    </div>

    <nav class="lg-sidebar">
        <a href="/user/" class="lg-nav-item"><i data-lucide="layout-grid"></i></a>
        <a href="/user/create" class="lg-nav-item"><i data-lucide="user-plus"></i></a>
        <a href="/user/list" class="lg-nav-item active"><i data-lucide="calendar-search"></i></a>
        <div style="flex-grow: 1;"></div>
        <a href="/logout" class="lg-nav-item"><i data-lucide="log-out"></i></a>
    </nav>

    <main class="lg-main-container">
        <div class="lg-breadcrumb">
            <span>Dashboard</span>
            <b>Usuários Cadastrados</b>
        </div>

        <div class="lg-header-flex">
            <div>
                <h1 class="lg-display-1">Gerenciamento de Usuários</h1>
            </div>
            <a href="/user/create" class="lg-btn-add">
                <i data-lucide="plus" style="width: 14px;"></i> Novo Usuário
            </a>
        </div>

        <div class="lg-table-container">
            <table class="lg-table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% for(usuario of usuarios) { %> 
                        <tr>
                            <td>#<%= usuario.id %></td>
                            <td style="color: var(--text-main); font-weight: 600;"><%= usuario.nome %></td>
                            <td><%= usuario.email %></td>
                            <td>
                                <div class="lg-actions">
                                    <a href="/user/edit/<%= usuario.id %>" class="lg-btn-icon" title="Editar">
                                        <i data-lucide="pencil"></i>
                                    </a>
                                    <button onclick="confirmarExclusao('<%= usuario.id %>')" class="lg-btn-icon danger" title="Excluir">
                                        <i data-lucide="trash-2"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    <% } %> 
                </tbody>
            </table>
        </div>
    </main>

    <script>
        lucide.createIcons();

        let usuarioIdParaApagar = null;
        const modal = document.getElementById('modalApagar');

        // Abre o modal e guarda o ID
        function confirmarExclusao(id) {
            usuarioIdParaApagar = id;
            modal.classList.add('active');
        }

        // Fecha o modal
        function fecharModal() {
            modal.classList.remove('active');
            usuarioIdParaApagar = null;
        }

        // Fecha modal se clicar fora dele
        window.onclick = function(event) {
            if (event.target == modal) fecharModal();
        }

        // Executa a exclusão real
        document.getElementById('confirmarDelete').addEventListener('click', async () => {
            if (!usuarioIdParaApagar) return;

            const url = "/user/delete/" + usuarioIdParaApagar;
            try {
                const response = await fetch(url, { method: 'DELETE' });
                if(response.ok) {
                    location.reload();
                } else {
                    alert("Erro ao excluir usuário.");
                    fecharModal();
                }
            } catch (err) {
                console.error("Erro na requisição:", err);
                fecharModal();
            }
        });
    </script>
</body>
</html>